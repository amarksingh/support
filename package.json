{
  "name": "@ostro/support",
  "version": "1.3.0",
  "description": "Support for OstroJS",
  "main": "build/function.js",
  "types": "build/function.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/function.d.ts",
      "default": "./build/function.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/contracts": "^1.0.2",
    "lodash": "^4.17.21",
    "luxon": "^2.0.2",
    "fs-extra": "^10.0.0"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "ostro support",
    "helper functions",
    "nodejs helpers",
    "ostrojs helpers",
    "ostro",
    "support"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/support.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/support/issues"
  },
  "homepage": "https://github.com/ostrojs/support#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
